{
  "name": "word-translation-shortcuts",
  "displayName": "Word Translation Shortcuts",
  "description": "一款纯粹的VSCode划词翻译插件",
  "keywords": [
    "翻译",
    "划词翻译",
    "translation",
    "word translation"
  ],
  "version": "0.1.6",
  "publisher": "chihang03",
  "author": {
    "name": "Kieran Dai"
  },
  "repository": "https://github.com/Chihang03/vscode-word-translation",
  "bugs": {
    "url": "https://github.com/Chihang03/vscode-word-translation/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "word-translation-shortcuts.translate",
        "title": "Translate"
      },
      {
        "command": "word-translation-shortcuts.dismiss",
        "title": "Dismiss Translation"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "word-translation-shortcuts.translate",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "word-translation-shortcuts.dismiss",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "word-translation-shortcuts.translate",
        "key": "alt+q",
        "mac": "ctrl+s",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "word-translation-shortcuts.dismiss",
        "key": "escape",
        "when": "hoverFocused && wordTranslationShortcuts.resultVisible"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "publish": "vsce package",
    "build:web": "webpack",
    "test:web": "npx vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ./dist/web/extension.js",
    "test": "node ./test/runTest.js",
    "test:unit": "node --test test/hover-regression.test.cjs"
  },
  "devDependencies": {
    "@types/glob": "^7.1.1",
    "@types/mocha": "^7.0.2",
    "@types/node": "^13.11.0",
    "@types/vscode": "^1.31.1",
    "@vscode/test-web": "^0.0.15",
    "eslint": "^6.8.0",
    "glob": "^7.1.6",
    "mocha": "^7.1.2",
    "typescript": "^3.8.3",
    "vscode-test": "^1.3.0",
    "webpack": "^5.60.0",
    "webpack-cli": "^4.9.1"
  },
  "dependencies": {},
  "homepage": "https://github.com/Chihang03/vscode-word-translation",
  "preview": true
}
